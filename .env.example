# 复制为 .env 后按本机修改
# docker compose 默认把 Postgres 映射到 55432，避免和本机 5432 冲突
DATABASE_URL=postgres://super_stock:123456@127.0.0.1:55432/super_stock?sslmode=disable

# https://tushare.pro 个人 token，不要提交到 git
TUSHARE_TOKEN=
# TUSHARE_URL=https://api.tushare.pro
# 每分钟请求上限（覆盖 config.yaml 的 tushare.rpm，默认 200）
# TUSHARE_RPM=200
# HTTP_ADDR=127.0.0.1:8080
